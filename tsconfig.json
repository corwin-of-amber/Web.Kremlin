{
    "compilerOptions": {
        "target": "es2020",
        "module": "es2020",
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "strict": false
    },
    "include": ["src"],
    "exclude": ["src/build/testbed.ts"]
}